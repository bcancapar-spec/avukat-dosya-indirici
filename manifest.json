{
  "manifest_version": 3,
  "name": "UYAP Evrak Indirici",
  "version": "1.6.1",
  "description": "UYAP avukat portalindaki dosya evraklarini list_dosya_evraklar.ajx cevabindan alip view_document_brd.uyap'a dogrudan fetch ile indirir; filtreleme, devam etme ve hata raporu destegi ile.",
  "minimum_chrome_version": "111",
  "permissions": ["downloads", "activeTab", "scripting", "offscreen", "storage"],
  "host_permissions": ["https://avukat.uyap.gov.tr/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://avukat.uyap.gov.tr/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "UYAP Evrak Indirici"
  }
}
