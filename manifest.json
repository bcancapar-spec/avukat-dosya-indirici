{
  "manifest_version": 3,
  "name": "UYAP Evrak Indirici",
  "version": "1.7.0",
  "description": "UYAP avukat ve vatandas portalindaki dosya evraklarini toplu indirir; filtreleme, devam etme ve hata raporu destegi ile.",
  "minimum_chrome_version": "111",
  "permissions": ["downloads", "activeTab", "scripting", "offscreen", "storage"],
  "host_permissions": [
    "https://avukat.uyap.gov.tr/*",
    "https://vatandas.uyap.gov.tr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://avukat.uyap.gov.tr/*",
        "https://vatandas.uyap.gov.tr/*"
      ],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "UYAP Evrak Indirici"
  }
}
